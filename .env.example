# ──────────────────────────────────────────────────────────────────────────
# OlivoWeb — variables de entorno
# Copia este archivo a .env.local y completa los valores. NUNCA commitees
# valores reales: .env* está en .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_SITE_URL=https://olivomarket.cl

# ── NextAuth ──
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://olivomarket.cl

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO en servidor. Rotar periódicamente.
SUPABASE_SERVICE_ROLE_KEY=

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=
# Secret de firma de webhooks (panel MP → Tus integraciones → Webhooks).
# Sin él, la firma de las notificaciones de pago NO se verifica.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Buscador de direcciones (Google Places, API New) ──
# OPCIONAL. Sin esta clave el checkout usa Nominatim (OpenStreetMap), que
# funciona pero casi no tiene numeración domiciliaria chilena.
#
# Al crearla en Google Cloud, tres cosas NO opcionales:
#   1. Restringir la clave a "Places API (New)".
#   2. Ponerle un LÍMITE DE CUOTA DIARIA a esa API (APIs y servicios → Cuotas).
#      Una alerta de presupuesto sólo manda un correo: el cobro sigue
#      corriendo. La cuota corta en seco y devuelve error, y el checkout cae
#      solo a Nominatim.
#   3. Dejarla acá y nunca en una variable NEXT_PUBLIC_*: si llega al
#      navegador, cualquiera puede gastarte la cuota.
GOOGLE_MAPS_API_KEY=

# ── Emails (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Signing secret del webhook (panel Resend → Webhooks → tu endpoint).
# Sin él, /api/webhooks/resend rechaza todos los eventos.
RESEND_WEBHOOK_SECRET=

# ── Cloudinary (imágenes) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Operación ──
# Protege /api/cron/auto-close-shifts (Vercel lo envía como Bearer).
# OBLIGATORIO: sin él, el cron responde 401 siempre.
CRON_SECRET=
# Token de un solo uso para crear el primer admin (/api/admin/bootstrap).
# Generar con: openssl rand -hex 32. Se deshabilita solo tras el primer admin.
ADMIN_SETUP_TOKEN=

# ── Uber Direct (despacho por courier) ──
# Panel: https://direct.uber.com → Desarrollador. Hay un juego de credenciales
# de prueba y otro de producción; el de producción va SOLO en las variables de
# entorno de Vercel, nunca en un archivo del repo.
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
